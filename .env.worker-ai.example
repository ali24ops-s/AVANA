# =============================================================================
# AVANA Worker AI Configuration (.env.worker-ai)
# =============================================================================
#
# Copy this file to `.env.worker-ai` and set your organization's AI API keys.
# This file is read by `npm run worker:setup` to configure the local worker.
#
# ⚠️ SECURITY NOTICE:
# - NEVER put Production Database URLs or DB passwords here.
# - NEVER put Payment Gateway secrets (Zarinpal) here.
# - Only configure the AI provider/model keys matching the main AVANA system.
# =============================================================================

# Primary AI Provider (gemini | gapgpt | groq | arvancloud | cloudflare)
AI_PRIMARY_PROVIDER=gemini

# AI Fallback: MUST remain false on Worker (automatic fallback to Groq is strictly disabled)
AI_ENABLE_FALLBACK=false

# -----------------------------------------------------------------------------
# Google Gemini (Default Primary Provider)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEY_1=your_first_key
# GEMINI_API_KEY_2=your_second_key
GEMINI_MODEL=gemini-3.6-flash

# -----------------------------------------------------------------------------
# Cloudflare Workers AI (Optional Provider / Study Assistant)
# -----------------------------------------------------------------------------
# CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
# CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
# CLOUDFLARE_AI_MODEL=@cf/zai-org/glm-4.7-flash

# -----------------------------------------------------------------------------
# GapGPT (Optional Provider)
# -----------------------------------------------------------------------------
# GAPGPT_API_KEY=your_gapgpt_api_key_here
# GAPGPT_BASE_URL=https://api.gapgpt.app/v1
# GAPGPT_MODEL=gpt-5.6-luna

# -----------------------------------------------------------------------------
# ArvanCloud (Optional Provider)
# -----------------------------------------------------------------------------
# ARVANCLOUD_API_KEY=your_arvancloud_key_here
# ARVANCLOUD_BASE_URL=https://arvancloudai.ir/gateway/models/DeepSeek-R1-qwen-7b-awq
# ARVANCLOUD_MODEL=DeepSeek-R1-qwen-7b-awq

# -----------------------------------------------------------------------------
# Groq (Optional Provider)
# -----------------------------------------------------------------------------
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-120b

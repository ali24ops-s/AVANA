{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": [
    "client.ts",
    "schema/**/*.ts",
    "migrations/**/*.ts",
    "seeds/**/*.ts",
    "tests/**/*.ts",
    "migrate.ts",
    "drizzle.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["dist", "node_modules"]
}

{
  "name": "@avana/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build --force",
    "type-check": "tsc --noEmit",
    "validate:openapi": "node ./scripts/validateOpenApi.node.ts"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}

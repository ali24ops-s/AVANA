# AVANA API — Local Development Environment
# Copy this file to .env and adjust as needed.

# Environment (development, test, production)
NODE_ENV=development

# API Server
AVANA_API_PORT=3000
AVANA_API_HOST=127.0.0.1

# HTTP
AVANA_HTTP_JSON_BODY_LIMIT=1mb

# CORS (comma-separated origins; defaults used if unset)
# AVANA_CORS_ORIGIN=http://localhost:5173

# Session
# AVANA_SESSION_COOKIE=avana_session
# AVANA_SESSION_MAX_AGE_MS=1209600000

# CSRF
# AVANA_CSRF_COOKIE=avana_csrf

# Cookie Security (defaults to true in production, false otherwise)
# AVANA_COOKIE_SECURE=false

# Google Analytics 4 Server-Side Measurement Protocol
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# GA4_API_SECRET=your_ga4_measurement_protocol_api_secret_here
# GA4_DEBUG_MODE=false

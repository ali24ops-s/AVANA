# AVANA API — Local Development Environment
# Copy this file to .env and adjust as needed.

# Environment (development, test, production)
NODE_ENV=development

# API Server
AVANA_API_PORT=3000
AVANA_API_HOST=127.0.0.1

# HTTP
AVANA_HTTP_JSON_BODY_LIMIT=1mb

# CORS (comma-separated origins; defaults used if unset)
# AVANA_CORS_ORIGIN=http://localhost:5173

# Session
# AVANA_SESSION_COOKIE=avana_session

# CSRF
# AVANA_CSRF_COOKIE=avana_csrf


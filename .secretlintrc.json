{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend",
      "rules": [
        {
          "id": "@secretlint/secretlint-rule-database-connection-string",
          "options": {
            "allows": [
              "/postgres(ql)?:\\/\\/[^\\s\"'`]+@(localhost|127\\.[0-9]+\\.[0-9]+\\.[0-9]+|\\[::1\\]|0\\.0\\.0\\.0|postgres|host\\.docker\\.internal)(:[0-9]+)?\\/[^\\s\"'`]*/",
              "/postgres:\\/\\/avana:avana@127\\.0\\.0\\.1:\\$\\{dbPort\\}\\/\\$\\{dbName\\}\\?sslmode=disable/"
            ]
          }
        }
      ]
    }
  ]
}

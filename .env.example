# =============================================================================
# AVANA Platform Environment Configuration Reference
# =============================================================================

# Server Environment (development | test | production)
NODE_ENV=development

# Canonical Public Frontend Web Application URL
# Used for password reset links, invitations, and email communication.
# Strictly decoupled from AVANA_CORS_ORIGIN and AVANA_API_HOST/PORT.
# Never configure this with a server IP address, API port, or plain HTTP in production.
# In production, this must be: AVANA_APP_URL=https://aavana.ir
AVANA_APP_URL=http://localhost:5173

# API Server Host and Port
AVANA_API_HOST=127.0.0.1
AVANA_API_PORT=3000

# Security & CORS (comma-separated list of allowed origins)
AVANA_CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Session & Cookie Configuration
AVANA_SESSION_COOKIE=avana_session
# AVANA_SESSION_MAX_AGE_MS=1209600000 # 14 days in milliseconds (default: 14 days)
AVANA_CSRF_COOKIE=avana_csrf
# Explicitly set secure flag on cookies (defaults to true in production, false otherwise). Set to false when serving production over HTTP (e.g. direct IP access).
# AVANA_COOKIE_SECURE=false

# Database Connection (PostgreSQL)
DATABASE_URL=postgres://avana:avana@127.0.0.1:5432/avana?sslmode=disable

# Redis Connection (BullMQ Queue & Caching)
REDIS_URL=redis://127.0.0.1:6379

# System Organization ID (Default Shared Courses Organization)
SYSTEM_ORGANIZATION_ID=b4a0b464-16db-4087-92b7-163a1e6f6776

# AI Generation Engine & Primary Provider (gemini | gapgpt | groq | arvancloud | cloudflare | mock)
# AI_PRIMARY_PROVIDER is the canonical provider selector (defaults to gemini)
AI_PRIMARY_PROVIDER=gemini
# AI_CONTENT_PROVIDER and AI_PROVIDER are supported for backward compatibility
# AI_CONTENT_PROVIDER=gemini
# AI Fallback Execution (false: strict single primary provider, true: auto-switch on failure)
AI_ENABLE_FALLBACK=false
AI_GENERATION_QUEUE=content_generate

# Local Document Upload Storage Directory
AVANA_STORAGE_LOCAL_DIRECTORY=./storage/uploads

# AI / Google Gemini Configuration (Primary Default Provider)
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEY_1=your_first_gemini_api_key
# GEMINI_API_KEY_2=your_second_gemini_api_key
# GEMINI_API_KEYS=key1,key2,key3
# GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: Dedicated SOCKS5 proxy URL for Google Gemini in restricted environments
# GEMINI_SOCKS_PROXY_URL=socks5://127.0.0.1:10808

# AI / GapGPT Configuration (Fallback 1 - OpenAI compatible)
# GAPGPT_API_KEY=your_gapgpt_api_key_here
# GAPGPT_BASE_URL=https://api.gapgpt.app/v1
# GAPGPT_MODEL=gpt-5.6-luna

# AI / Groq Configuration (Fallback 2)
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-120b

# AI / ArvanCloud Configuration (Additional Fallback)
# ARVANCLOUD_API_TOKEN=your_arvancloud_token_here
# ARVANCLOUD_BASE_URL=https://arvancloudai.ir/gateway/models/DeepSeek-R1-qwen-7b-awq
# ARVANCLOUD_MODEL=DeepSeek-R1-qwen-7b-awq
# ARVANCLOUD_AUTH_SCHEME=apikey
# ARVANCLOUD_TIMEOUT_MS=180000

# AI / Cloudflare Workers AI Configuration
# AI_PROVIDER=cloudflare
# CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
# CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
# CLOUDFLARE_AI_MODEL=@cf/zai-org/glm-4.7-flash

# User-Facing AI (Content Generation & «از آوانا بپرس» / GapGPT + deepseek-v4-flash)
USER_AI_PROVIDER=gapgpt
GAPGPT_API_KEY=your_gapgpt_api_key_here
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
GAPGPT_USER_AI_MODEL=deepseek-v4-flash
# Legacy User AI (OpenRouter fallback/migration support)
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_USER_AI_MODEL=deepseek/deepseek-v4-flash-0731
# OPENROUTER_HTTP_REFERER=https://your-domain.com
# OPENROUTER_TITLE=AVANA

# Email Verification Provider (mock | resend)
EMAIL_PROVIDER=mock
# RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=AVANA <onboarding@resend.dev>

# Telegram Operational Alerts (Admin/Operator)
# Disabled by default. Set to true in production once BOT_TOKEN is configured.
TELEGRAM_ALERTS_ENABLED=false
# TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=629710703
# Optional: Reverse proxy base URL if direct api.telegram.org is restricted (defaults to https://api.telegram.org)
# TELEGRAM_API_BASE_URL=https://api.telegram.org
# TELEGRAM_TIMEOUT_MS=5000
# Optional: Outbound SOCKS5 proxy URL for restricted environments (e.g. socks5://127.0.0.1:1080 or socks5h://127.0.0.1:1080)
# TELEGRAM_SOCKS_PROXY_URL=socks5://127.0.0.1:1080

# Google Tag Manager & Web Analytics (Frontend)
# Container ID for production tag management
VITE_GTM_ID=GTM-529742BL
# Optional: Set to true to explicitly test analytics events in development
# VITE_ANALYTICS_ENABLED=false

# Google Analytics 4 Server-Side Measurement Protocol (Backend Purchase Tracking)
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# GA4_API_SECRET=your_ga4_measurement_protocol_api_secret_here
# GA4_DEBUG_MODE=false


# =============================================================================
# AVANA Platform Environment Configuration Reference
# =============================================================================

# Server Environment (development | test | production)
NODE_ENV=development

# API Server Host and Port
AVANA_API_HOST=127.0.0.1
AVANA_API_PORT=3000

# Security & CORS (comma-separated list of allowed origins)
AVANA_CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Session & Cookie Configuration
AVANA_SESSION_COOKIE=avana_session
AVANA_CSRF_COOKIE=avana_csrf

# Frontend Authentication Feature Flag
# Set to 'false' for Public/Demo Mode (e.g. GitHub Pages without production backend auth)
# Set to 'true' to restore full Login/Register/Session authentication system
VITE_AUTH_ENABLED=false

# Database Connection (PostgreSQL)
DATABASE_URL=postgres://avana:avana@127.0.0.1:5432/avana?sslmode=disable

# Redis Connection (BullMQ Queue & Caching)
REDIS_URL=redis://127.0.0.1:6379

# System Organization ID (Default Shared Courses Organization)
SYSTEM_ORGANIZATION_ID=b4a0b464-16db-4087-92b7-163a1e6f6776

# AI Generation Engine & Primary Provider (gemini | gapgpt | groq | arvancloud | cloudflare | mock)
# AI_PRIMARY_PROVIDER is the canonical provider selector (defaults to gemini)
AI_PRIMARY_PROVIDER=gemini
# AI_CONTENT_PROVIDER and AI_PROVIDER are supported for backward compatibility
# AI_CONTENT_PROVIDER=gemini
# AI Fallback Execution (false: strict single primary provider, true: auto-switch on failure)
AI_ENABLE_FALLBACK=false
AI_GENERATION_QUEUE=content_generate

# Local Document Upload Storage Directory
AVANA_STORAGE_LOCAL_DIRECTORY=./storage/uploads

# AI / Google Gemini Configuration (Primary Default Provider)
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEY_1=your_first_gemini_api_key
# GEMINI_API_KEY_2=your_second_gemini_api_key
# GEMINI_API_KEYS=key1,key2,key3
# GEMINI_MODEL=gemini-3.6-flash

# AI / GapGPT Configuration (Fallback 1 - OpenAI compatible)
# GAPGPT_API_KEY=your_gapgpt_api_key_here
# GAPGPT_BASE_URL=https://api.gapgpt.app/v1
# GAPGPT_MODEL=gpt-5.6-luna

# AI / Groq Configuration (Fallback 2)
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-120b

# AI / ArvanCloud Configuration (Additional Fallback)
# ARVANCLOUD_API_TOKEN=your_arvancloud_token_here
# ARVANCLOUD_BASE_URL=https://arvancloudai.ir/gateway/models/DeepSeek-R1-qwen-7b-awq
# ARVANCLOUD_MODEL=DeepSeek-R1-qwen-7b-awq
# ARVANCLOUD_AUTH_SCHEME=apikey
# ARVANCLOUD_TIMEOUT_MS=180000

# AI / Cloudflare Workers AI Configuration
# AI_PROVIDER=cloudflare
# CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
# CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
# CLOUDFLARE_AI_MODEL=@cf/zai-org/glm-4.7-flash

# Email Verification Provider (mock | resend)
EMAIL_PROVIDER=mock
# RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=AVANA <onboarding@resend.dev>

